{
    "name": "mikro-api/mikro-api",
    "description": "Minimalist PHP framework inspired by NestJS: modules, attribute-based routing, validation, guards, interceptors, migrations and a code-generating CLI",
    "type": "library",
    "keywords": ["framework", "api", "rest", "php8", "attributes", "nestjs", "minimal", "jwt", "validation", "migrations"],
    "license": "MIT",
    "authors": [
        {
            "name": "MikroAPI Contributors",
            "email": "info@mikro-api.dev"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "9.5.28",
        "doctrine/instantiator": "^1.5"
    },
    "suggest": {
        "turso/libsql": "Required to use the 'turso' database driver (Database::connect with driver => 'turso'); needs PHP >= 8.3 and the FFI extension with ffi.enable=true"
    },
    "autoload": {
        "psr-4": {
            "MikroApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikroApi\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/mikro"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "migrate": "mikro migrate",
        "migrate:rollback": "mikro migrate:rollback",
        "migrate:status": "mikro migrate:status",
        "migrate:reset": "mikro migrate:reset"
    }
}
