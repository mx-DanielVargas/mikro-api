#!/usr/bin/env php
<?php

/**
 * MikroAPI CLI
 *
 * Migrations:
 *   vendor/bin/mikro-migrate migrate              → Run pending migrations
 *   vendor/bin/mikro-migrate rollback              → Rollback last migration
 *   vendor/bin/mikro-migrate reset                  → Rollback all migrations
 *   vendor/bin/mikro-migrate status                 → Show migration status
 *   vendor/bin/mikro-migrate make <name>            → Create new migration file
 *
 * Project scaffolding:
 *   vendor/bin/mikro-migrate init [path]            → Scaffold a full project structure
 *
 * Code generators:
 *   vendor/bin/mikro-migrate make:controller <Name> → Create a controller
 *   vendor/bin/mikro-migrate make:repository <Name> → Create a repository
 *   vendor/bin/mikro-migrate make:dto <Name>        → Create a validation DTO
 *   vendor/bin/mikro-migrate make:middleware <Name> → Create a middleware
 *   vendor/bin/mikro-migrate make:guard <Name>      → Create a guard
 *   vendor/bin/mikro-migrate make:service <Name>    → Create a service
 */

declare(strict_types=1);

// Try to find autoload from different possible locations
$autoloadPaths = [
    __DIR__ . '/../../../autoload.php',  // Installed as dependency
    __DIR__ . '/../vendor/autoload.php', // Development
];

$autoloadFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require_once $autoloadPath;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    echo "Error: Could not find autoload.php\n";
    echo "Make sure you run 'composer install' first.\n";
    exit(1);
}

use MikroApi\Config\ConfigService;
use MikroApi\Database\Database;
use MikroApi\Database\MigrationRunner;

$command = $argv[1] ?? 'help';

// Determine project root (where composer.json is)
$projectRoot = getcwd();

// Load .env (if present) as early as possible. This has no effect if the
// file doesn't exist, and lets config/database.php (and any other config
// file) read $_ENV/getenv() consistently whether the app runs via HTTP
// (App::useConfig()) or through this CLI tool.
new ConfigService($projectRoot);

// ── Command: init (project scaffolding, doesn't need a database) ───────────
if ($command === 'init') {
    runInit($projectRoot, $argv[2] ?? '.');
    exit(0);
}

// ── Commands: make:* generators (don't need a database) ──────────────────
$generators = [
    'make:controller' => 'generateController',
    'make:repository' => 'generateRepository',
    'make:dto'         => 'generateDto',
    'make:middleware'  => 'generateMiddleware',
    'make:guard'       => 'generateGuard',
    'make:service'     => 'generateService',
];

if (isset($generators[$command])) {
    $name = $argv[2] ?? null;
    if (!$name) {
        echo "Usage: vendor/bin/mikro-migrate {$command} <Name>\n";
        exit(1);
    }
    $ok = $generators[$command]($projectRoot, $name);
    exit($ok ? 0 : 1);
}

// ── Command: make (doesn't need database) ─────────────────────────────────────────
if ($command === 'make') {
    $name = $argv[2] ?? null;
    if (!$name) {
        echo "Usage: vendor/bin/mikro-migrate make <name>\n";
        echo "Example: vendor/bin/mikro-migrate make create_products_table\n";
        exit(1);
    }

    $dir = $projectRoot . '/database/migrations';
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    $timestamp = date('Y_m_d_His');
    $filename  = "{$timestamp}_{$name}.php";
    $className = studlyCase($name);

    $stub = <<<PHP
<?php

namespace Database\Migrations;

use MikroApi\Database\Migration;
use MikroApi\Attributes\Schema\Table;
use MikroApi\Attributes\Schema\Column;
use MikroApi\Attributes\Schema\PrimaryKey;
use MikroApi\Attributes\Schema\Unique;
use MikroApi\Attributes\Schema\Index;
use MikroApi\Attributes\Schema\ForeignKey;
use MikroApi\Attributes\Schema\Timestamps;
use MikroApi\Attributes\Schema\SoftDeletes;

#[Table('{$name}')]
#[Timestamps]
class {$className} extends Migration
{
    #[PrimaryKey]
    #[Column(type: 'int')]
    public \$id;

    // Define your columns here with attributes
}
PHP;

    file_put_contents("{$dir}/{$filename}", $stub);
    echo "✓ Migration created: database/migrations/{$filename}\n";
    exit(0);
}

// ── Other commands: need database ──────────────────────────────────────────────────────
if (!in_array($command, ['migrate', 'rollback', 'reset', 'status'], true)) {
    showHelp();
    exit($command === 'help' ? 0 : 1);
}

$configPath = $projectRoot . '/config/database.php';

if (!file_exists($configPath)) {
    echo "Error: Database configuration not found at {$configPath}\n";
    echo "Please create config/database.php with your database settings, or run:\n";
    echo "  vendor/bin/mikro-migrate init\n";
    exit(1);
}

$config = require $configPath;

try {
    $db = Database::connect($config);
    $runner = new MigrationRunner(
        db: $db,
        migrationsPath: $projectRoot . '/database/migrations',
        migrationsNamespace: 'Database\\Migrations',
    );

    match ($command) {
        'migrate'  => $runner->migrate(),
        'rollback' => $runner->rollback(),
        'reset'    => $runner->reset(),
        'status'   => $runner->status(),
    };
} catch (\Throwable $e) {
    echo "Error: " . $e->getMessage() . "\n";
    exit(1);
}

function showHelp(): void
{
    echo <<<HELP
MikroAPI CLI

Usage: vendor/bin/mikro-migrate <command>

Project scaffolding:
  init [path]                 Scaffold a full project structure (default: current directory)

Migrations:
  make <name>                 Create a new migration file
  migrate                      Run all pending migrations
  rollback                      Rollback the last migration
  reset                          Rollback all migrations
  status                          Show status of all migrations

Code generators:
  make:controller <Name>      Create a controller in src/Controllers/
  make:repository <Name>      Create a repository in src/Repositories/
  make:dto <Name>              Create a validation DTO in src/DTOs/
  make:middleware <Name>       Create a middleware in src/Middleware/
  make:guard <Name>            Create a guard in src/Guards/
  make:service <Name>          Create a service in src/Services/

Examples:
  vendor/bin/mikro-migrate init
  vendor/bin/mikro-migrate make:controller Product
  vendor/bin/mikro-migrate make create_users_table
  vendor/bin/mikro-migrate migrate
  vendor/bin/mikro-migrate status

HELP;
}

// ══════════════════════════════════════════════════════════════════════════════════
// Helpers
// ══════════════════════════════════════════════════════════════════════════════════

/** snake_case / kebab-case / "free text" → StudlyCase */
function studlyCase(string $name): string
{
    $name = str_replace(['-', '_'], ' ', $name);
    return str_replace(' ', '', ucwords($name));
}

/** StudlyCase / camelCase → snake_case */
function snakeCase(string $name): string
{
    return strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $name));
}

/** Naive English pluralizer, good enough for generator stubs (editable by the developer afterwards) */
function pluralize(string $word): string
{
    if (preg_match('/(s|x|z|ch|sh)$/i', $word)) {
        return $word . 'es';
    }
    if (preg_match('/y$/i', $word) && !preg_match('/[aeiou]y$/i', $word)) {
        return substr($word, 0, -1) . 'ies';
    }
    return $word . 's';
}

/**
 * Writes a generated file, refusing to overwrite an existing one.
 * Creates the parent directory if it doesn't exist yet.
 *
 * @return bool true if the file was written, false if it already existed
 */
function writeGeneratedFile(string $path, string $contents): bool
{
    $dir = dirname($path);
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    if (file_exists($path)) {
        echo "✗ Already exists, skipped: " . relativePath($path) . "\n";
        return false;
    }

    file_put_contents($path, $contents);
    echo "✓ Created: " . relativePath($path) . "\n";
    return true;
}

/**
 * Writes a scaffolded file for `init`, silently skipping (not failing) if it
 * already exists — safe to re-run `init` on a partially set up project.
 */
function writeScaffoldFile(string $path, string $contents): void
{
    $dir = dirname($path);
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }

    if (file_exists($path)) {
        echo "  - skipped (already exists): " . relativePath($path) . "\n";
        return;
    }

    file_put_contents($path, $contents);
    echo "  - created: " . relativePath($path) . "\n";
}

function relativePath(string $path): string
{
    $cwd = getcwd() . '/';
    return str_starts_with($path, $cwd) ? substr($path, strlen($cwd)) : $path;
}

// ══════════════════════════════════════════════════════════════════════════════════
// Code generators (make:controller, make:repository, make:dto, ...)
// ══════════════════════════════════════════════════════════════════════════════════

function generateController(string $projectRoot, string $name): bool
{
    $class  = studlyCase($name);
    if (!str_ends_with($class, 'Controller')) {
        $class .= 'Controller';
    }
    $base   = substr($class, 0, -strlen('Controller'));
    $prefix = '/api/' . pluralize(strtolower(snakeCase($base)));
    $prefix = str_replace('_', '-', $prefix);

    $stub = <<<PHP
<?php

namespace App\Controllers;

use MikroApi\Request;
use MikroApi\Response;
use MikroApi\Attributes\Controller;
use MikroApi\Attributes\Route;

#[Controller('{$prefix}')]
class {$class}
{
    #[Route('GET', '/')]
    public function index(Request \$req): Response
    {
        return Response::json([]);
    }

    #[Route('GET', '/:id')]
    public function show(Request \$req): Response
    {
        \$id = \$req->params['id'];

        return Response::json(['id' => \$id]);
    }

    #[Route('POST', '/')]
    public function store(Request \$req): Response
    {
        return Response::json(\$req->body, 201);
    }

    #[Route('PUT', '/:id')]
    public function update(Request \$req): Response
    {
        \$id = \$req->params['id'];

        return Response::json(array_merge(['id' => \$id], \$req->body));
    }

    #[Route('DELETE', '/:id')]
    public function destroy(Request \$req): Response
    {
        return Response::empty();
    }
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/Controllers/{$class}.php", $stub);
}

function generateRepository(string $projectRoot, string $name): bool
{
    $class = studlyCase($name);
    if (!str_ends_with($class, 'Repository')) {
        $class .= 'Repository';
    }
    $base  = substr($class, 0, -strlen('Repository'));
    $table = pluralize(snakeCase($base));

    $stub = <<<PHP
<?php

namespace App\Repositories;

use MikroApi\Repository\BaseRepository;

class {$class} extends BaseRepository
{
    protected string \$table = '{$table}';

    /** @var string[] Columns that may be mass-assigned via create()/update() */
    protected array \$fillable = [
        // 'name', 'email', ...
    ];

    // #[HasMany(repository: SomeRelatedRepository::class, foreignKey: '{$base}_id')]
    // public array \$related;
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/Repositories/{$class}.php", $stub);
}

function generateDto(string $projectRoot, string $name): bool
{
    $class = studlyCase($name);
    if (!str_ends_with($class, 'Dto')) {
        $class .= 'Dto';
    }

    $stub = <<<PHP
<?php

namespace App\DTOs;

use MikroApi\RequestDto;
use MikroApi\Attributes\Validation\Required;
use MikroApi\Attributes\Validation\Optional;
use MikroApi\Attributes\Validation\IsString;
use MikroApi\Attributes\Validation\IsEmail;
use MikroApi\Attributes\Validation\MinLength;
use MikroApi\Attributes\Validation\MaxLength;

class {$class} extends RequestDto
{
    // #[Required]
    // #[IsString]
    // #[MinLength(2)]
    // #[MaxLength(100)]
    // public string \$name;

    // #[Optional]
    // #[IsEmail]
    // public ?string \$email;
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/DTOs/{$class}.php", $stub);
}

function generateMiddleware(string $projectRoot, string $name): bool
{
    $class = studlyCase($name);
    if (!str_ends_with($class, 'Middleware')) {
        $class .= 'Middleware';
    }

    $stub = <<<PHP
<?php

namespace App\Middleware;

use MikroApi\Middleware\MiddlewareInterface;
use MikroApi\Request;
use MikroApi\Response;

class {$class} implements MiddlewareInterface
{
    public function handle(Request \$request, callable \$next): Response
    {
        // Code here runs BEFORE the rest of the pipeline (routing included)

        \$response = \$next(\$request);

        // Code here runs AFTER the rest of the pipeline, right before sending
        // the response — e.g. \$response = \$response->withHeader(...)

        return \$response;
    }
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/Middleware/{$class}.php", $stub);
}

function generateGuard(string $projectRoot, string $name): bool
{
    $class = studlyCase($name);
    if (!str_ends_with($class, 'Guard')) {
        $class .= 'Guard';
    }

    $stub = <<<PHP
<?php

namespace App\Guards;

use MikroApi\BaseGuard;
use MikroApi\Request;

/**
 * Attach to a route or controller with #[UseGuards({$class}::class)].
 */
class {$class} extends BaseGuard
{
    public function canActivate(Request \$request): bool
    {
        // Return true to allow the request through, false to deny it.
        // deny() (inherited from BaseGuard) returns a 401 Unauthorized by
        // default — override it if you need a different response.

        return true;
    }
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/Guards/{$class}.php", $stub);
}

function generateService(string $projectRoot, string $name): bool
{
    $class = studlyCase($name);
    if (!str_ends_with($class, 'Service')) {
        $class .= 'Service';
    }

    $stub = <<<PHP
<?php

namespace App\Services;

use MikroApi\Service\BaseService;

class {$class} extends BaseService
{
    public function __construct(
        // Inject repositories/services here — the DI Container will
        // autowire them automatically when this service is resolved.
    ) {}

    // Use \$this->fail(), \$this->notFound(), \$this->unauthorized(),
    // \$this->forbidden() or \$this->conflict() (all inherited from
    // BaseService) to raise business errors with the right HTTP status.
}
PHP;

    return writeGeneratedFile("{$projectRoot}/src/Services/{$class}.php", $stub);
}

// ══════════════════════════════════════════════════════════════════════════════════
// Project scaffolding (init)
// ══════════════════════════════════════════════════════════════════════════════════

function runInit(string $projectRoot, string $target): void
{
    $root = rtrim($projectRoot . '/' . ltrim($target, './'), '/');
    if ($target === '.' || $target === './') {
        $root = rtrim($projectRoot, '/');
    }

    echo "Scaffolding a new MikroAPI project at: " . relativePath($root) . "/\n\n";

    // ── Directories ────────────────────────────────────────────────────
    foreach ([
        '/src/Controllers',
        '/src/Repositories',
        '/src/DTOs',
        '/src/Middleware',
        '/src/Guards',
        '/src/Services',
        '/database/migrations',
        '/views',
        '/public',
        '/tests',
    ] as $dir) {
        $path = $root . $dir;
        if (!is_dir($path)) {
            mkdir($path, 0755, true);
        }
    }

    // ── public/index.php (front controller) ────────────────────────
    writeScaffoldFile($root . '/public/index.php', <<<'PHP'
<?php

/**
 * Front controller — run with:
 *   php -S localhost:8000 -t public public/index.php
 */

require __DIR__ . '/../vendor/autoload.php';

use MikroApi\App;
use MikroApi\Middleware\CorsMiddleware;
use MikroApi\Middleware\JsonBodyMiddleware;
use App\Controllers\HomeController;

$app = new App();

// Loads .env from the project root (APP_ENV, DB_*, etc.)
$app->useConfig(__DIR__ . '/..');

// Views (see the "templates" example in mikro-api/examples for the full
// templating syntax: layouts, sections, includes, directives).
$app->useViews(__DIR__ . '/../views');

// Global middleware pipeline — order matters, see the "middleware" example
// in mikro-api/examples for a detailed walkthrough of why.
$app->useMiddleware(
    new CorsMiddleware(),
    new JsonBodyMiddleware(),
);

// Register your controllers here.
$app->useController(
    HomeController::class,
);

// Uncomment to cache compiled routes/views in production (must be called
// before useController()/right after useViews() respectively — see the
// "Performance Caching" section of the MikroAPI README):
// $app->cacheRoutes(__DIR__ . '/../cache/routes.php');

$app->run();
PHP);

    // ── src/Controllers/HomeController.php ────────────────────────
    writeScaffoldFile($root . '/src/Controllers/HomeController.php', <<<'PHP'
<?php

namespace App\Controllers;

use MikroApi\Request;
use MikroApi\Response;
use MikroApi\Attributes\Controller;
use MikroApi\Attributes\Route;

#[Controller('')]
class HomeController
{
    #[Route('GET', '/')]
    public function index(Request $req): Response
    {
        return Response::json([
            'message'   => 'Welcome to your new MikroAPI project!',
            'timestamp' => date('c'),
        ]);
    }
}
PHP);

    // ── config/database.php ──────────────────────────────────────
    writeScaffoldFile($root . '/config/database.php', <<<'PHP'
<?php

// SQLite by default — zero external setup required.
return [
    'driver'   => 'sqlite',
    'database' => __DIR__ . '/../database/database.sqlite',
];

// MySQL/MariaDB alternative (uncomment and remove the block above).
// Values are read from .env via App::useConfig()/this CLI tool, both of
// which populate $_ENV before this file is loaded.
// return [
//     'driver'   => 'mysql',
//     'host'     => $_ENV['DB_HOST'] ?? 'localhost',
//     'port'     => (int) ($_ENV['DB_PORT'] ?? 3306),
//     'database' => $_ENV['DB_DATABASE'] ?? 'my_app',
//     'username' => $_ENV['DB_USERNAME'] ?? 'root',
//     'password' => $_ENV['DB_PASSWORD'] ?? '',
//     'charset'  => 'utf8mb4',
// ];
PHP);

    // ── database/migrations/*_create_users_table.php ─────────────────
    $migrationFile = $root . '/database/migrations/2024_01_01_000001_create_users_table.php';
    if (!file_exists($migrationFile) && !hasAnyMigration($root)) {
        writeScaffoldFile($migrationFile, <<<'PHP'
<?php

namespace Database\Migrations;

use MikroApi\Database\Migration;
use MikroApi\Attributes\Schema\Table;
use MikroApi\Attributes\Schema\Column;
use MikroApi\Attributes\Schema\PrimaryKey;
use MikroApi\Attributes\Schema\Unique;
use MikroApi\Attributes\Schema\Timestamps;

#[Table('users')]
#[Timestamps]
class CreateUsersTable extends Migration
{
    #[PrimaryKey]
    #[Column(type: 'int')]
    public int $id;

    #[Column(type: 'varchar', length: 100)]
    public string $name;

    #[Column(type: 'varchar', length: 150)]
    #[Unique]
    public string $email;

    #[Column(type: 'varchar', length: 255)]
    public string $password;
}
PHP);
    } else {
        echo "  - skipped (a migration already exists): database/migrations/2024_01_01_000001_create_users_table.php\n";
    }

    // ── views/home.php ──────────────────────────────────────────
    writeScaffoldFile($root . '/views/home.php', <<<'PHP'
<h1>{{ $title ?? 'Welcome' }}</h1>
<p>This view is rendered by MikroAPI's built-in template engine.</p>
PHP);

    // ── .env / .env.example ────────────────────────────────────────
    $envContents = <<<ENV
APP_NAME="My MikroAPI App"
APP_ENV=development
APP_DEBUG=true

# DB_* variables are only read if you switch config/database.php to MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=my_app
DB_USERNAME=root
DB_PASSWORD=
ENV;
    writeScaffoldFile($root . '/.env', $envContents);
    writeScaffoldFile($root . '/.env.example', $envContents);

    // ── .gitignore ─────────────────────────────────────────────────────────
    writeScaffoldFile($root . '/.gitignore', <<<'GITIGNORE'
/vendor/
/cache/
/database/*.sqlite
/database/*.sqlite-*
.env
.DS_Store
composer.lock
GITIGNORE);

    // ── composer.json (only if it doesn't already exist) ─────────────
    $composerPath = $root . '/composer.json';
    if (!file_exists($composerPath)) {
        writeScaffoldFile($composerPath, <<<'JSON'
{
    "name": "your-vendor/your-app",
    "description": "A MikroAPI application",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mikro-api/mikro-api": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
JSON);
    } else {
        echo "  - skipped (composer.json already exists): make sure it has \"App\\\\\": \"src/\" under autoload.psr-4, and requires mikro-api/mikro-api\n";
    }

    // ── README.md ────────────────────────────────────────────────────────
    writeScaffoldFile($root . '/README.md', <<<'MD'
# My MikroAPI App

Scaffolded with `vendor/bin/mikro-migrate init`.

## Getting Started

```bash
composer install
php -S localhost:8000 -t public public/index.php
curl http://localhost:8000/
```

## Project Structure

```
├── public/index.php        Front controller (bootstraps App, middlewares, controllers)
├── src/
│   ├── Controllers/         HTTP controllers (#[Controller]/#[Route])
│   ├── Repositories/        Data access (BaseRepository + QueryBuilder)
│   ├── DTOs/                Request validation (RequestDto + validation attributes)
│   ├── Middleware/           Custom middleware (MiddlewareInterface)
│   ├── Guards/               Route/controller guards (BaseGuard)
│   └── Services/             Business logic (BaseService)
├── database/migrations/      Attribute-driven schema migrations
├── config/database.php       Database connection config
├── views/                    Templates rendered via Response::render()
├── .env                      Environment configuration (not committed)
└── tests/                    PHPUnit tests
```

## Common Commands

```bash
# Migrations
vendor/bin/mikro-migrate make create_products_table
vendor/bin/mikro-migrate migrate
vendor/bin/mikro-migrate status
vendor/bin/mikro-migrate rollback

# Code generators
vendor/bin/mikro-migrate make:controller Product
vendor/bin/mikro-migrate make:repository Product
vendor/bin/mikro-migrate make:dto CreateProduct
vendor/bin/mikro-migrate make:middleware RequestId
vendor/bin/mikro-migrate make:guard Jwt
vendor/bin/mikro-migrate make:service Product
```

See the [MikroAPI README](https://github.com/mikro-api/mikro-api) and its
[`examples/`](https://github.com/mikro-api/mikro-api/tree/master/examples)
directory for the full feature set (relations, soft deletes, Swagger docs,
rate limiting, config namespaces, route/view caching, and more).
MD);

    echo "\nDone! Next steps:\n";
    echo "  1. composer install\n";
    echo "  2. php -S localhost:8000 -t public public/index.php\n";
    echo "  3. curl http://localhost:8000/\n";
}

function hasAnyMigration(string $root): bool
{
    $dir = $root . '/database/migrations';
    return is_dir($dir) && count(glob($dir . '/*.php') ?: []) > 0;
}
